{
  "name": "dsh-small-toolkit",
  "description": "A collection of small DeepSeek Harness features: keep the Mac awake while dsh runs, and a macOS notification when a conversation finishes its task — clicking the notification brings DeepSeek Harness forward.",
  "version": "0.2.2",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.2 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HanYu-me/dsh-small-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/HanYu-me/dsh-small-toolkit/issues"
  },
  "homepage": "https://github.com/HanYu-me/dsh-small-toolkit#readme",
  "author": "Yu Han",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "caffeinate",
    "notification",
    "macos"
  ]
}
