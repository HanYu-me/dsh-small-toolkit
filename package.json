{
  "name": "dsh-small-toolkit",
  "description": "Small DeepSeek Harness features with a settings page on the Plugins page: keep the Mac awake while dsh runs, and a macOS notification when a conversation finishes its task. Each feature has its own switch, changed live without a restart.",
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.2 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node scripts/build-client.mjs",
    "test:ui": "node test/ui.mjs"
  },
  "files": [
    "lib",
    "client/client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HanYu-me/dsh-small-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/HanYu-me/dsh-small-toolkit/issues"
  },
  "homepage": "https://github.com/HanYu-me/dsh-small-toolkit#readme",
  "author": "Yu Han",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "caffeinate",
    "notification",
    "macos"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.0",
    "react": "^18.3.1",
    "react-dom": "~18.3.1"
  }
}
